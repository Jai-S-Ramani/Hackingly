# VerifyAI Environment Configuration Template

# Database Provider: 'supabase' or 'sqlite'
DATABASE_PROVIDER=supabase

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key

# Server Settings
HOST=0.0.0.0
PORT=8000
