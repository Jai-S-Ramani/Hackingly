  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Forensics",
      "items": [
        "Participant uploads ID document image and optional selfie via multipart form",
        "Stage 1 evaluates Laplacian blur variance and Error Level Analysis (ELA) tampering artifacts",
        "Stage 2 uses a pluggable OCR adapter with Aadhaar Verhoeff checksum algorithm"
      ]
    },
    {
      "dot": "emerald",
      "title": "Biometrics & Fraud Defense",
      "items": [
        "Stage 3 matches selfie face embeddings with ID photo via DeepFace",
        "RapidFuzz validates participant name against registration form",
        "Stage 4 detects duplicate IDs and serial reuse across different names via SHA-256 hashes"
      ]
    },
    {
      "dot": "violet",
      "title": "Decision & Review",
      "items": [
        "Stage 5 computes weighted confidence scores and enforces event eligibility rules",
        "Generates 3-tier verdict (Approved, Manual Review, Rejected) with plain-English reasons",
        "Streamlit organizer dashboard provides real-time review, audit history, and manual overrides"
      ]
    }
  ]
