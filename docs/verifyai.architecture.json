  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Forensics",
      "items": [
        "Participant uploads ID document image and optional selfie via multipart form or web portal",
        "Stage 1 evaluates Laplacian blur variance and Error Level Analysis (ELA) tampering artifacts",
        "Stage 2 uses a pluggable OCR adapter with Aadhaar Verhoeff checksum algorithm"
      ]
    },
    {
      "dot": "emerald",
      "title": "Biometrics & Fraud Defense",
      "items": [
        "Stage 3 matches selfie face embeddings with ID photo via DeepFace and validates form name via RapidFuzz",
        "Stage 4 computes SHA-256 fingerprint of ID document to detect reuse across different registrants",
        "Cloud duplicate detection queries Supabase id_hashes index with sub-millisecond lookups"
      ]
    },
    {
      "dot": "violet",
      "title": "Decision & Supabase Cloud",
      "items": [
        "Stage 5 computes weighted confidence scores and enforces event eligibility rules",
        "Supabase cloud PostgreSQL stores all participant registrations, audit trails, and SHA-256 hashes",
        "Streamlit dashboard provides live review, ELA heatmaps, face audit, and manual overrides"
      ]
    }
  ]
