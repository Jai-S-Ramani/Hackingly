  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Forensic Analysis",
      "items": [
        "Participant submits ID documents through applicant portal or direct REST endpoint",
        "Stage 1 performs Laplacian blur analysis and Error Level Analysis (ELA) tampering detection",
        "Stage 2 extracts document text with EasyOCR and verifies checksum with Aadhaar Verhoeff algorithm"
      ]
    },
    {
      "dot": "emerald",
      "title": "Biometrics & Fraud Defense",
      "items": [
        "Stage 3 matches selfie face embeddings with ID photo via DeepFace and validates form name via RapidFuzz",
        "Stage 4 generates cryptographic SHA-256 fingerprint of ID document to detect reuse across applicants",
        "Real-time duplicate detection queries Supabase id_hashes index with zero local SQLite dependencies"
      ]
    },
    {
      "dot": "violet",
      "title": "Decision & Supabase Cloud",
      "items": [
        "Stage 5 computes weighted confidence scores and enforces event-specific eligibility policies",
        "Supabase Cloud PostgreSQL acts as the single source of truth for registrations, verifications, and hashes",
        "Verispect Command Center (Next.js 16) and Ops Console provide dual-theme live inspection and human override"
      ]
    }
  ]
